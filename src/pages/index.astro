---
import MainLayout from '../layouts/MainLayout.astro';
import MeowEditor from '../components/MeowEditor.astro';

const heroSnippet = `iz main() {
    meow!("hai hooman! i can haz cheezburger?");
}`;

const courses = [
    {
        slug: 'lolrust',
        name: 'LolRust',
        tagline: 'Real Rust, in lolcat',
        href: '/lolrust/lesson-1',
        status: 'available',
        lessons: 16,
        blurb: 'Borrow checker rebranded as the No Touchie Checker. Compiles to native binaries. Yes, really.',
    },
    {
        slug: 'lolpython',
        name: 'LolPython',
        tagline: 'PEP 8? more like PEP MEOW',
        href: '#',
        status: 'soon',
        lessons: null,
        blurb: 'Coming whenever a cat sits on the keyboard long enough.',
    },
    {
        slug: 'braincat',
        name: 'BrainCat',
        tagline: 'Brainfuck, but every symbol is a paw print',
        href: '#',
        status: 'soon',
        lessons: null,
        blurb: 'For when you need your code to be unreadable AND adorable.',
    },
];
---
<MainLayout title="Meowademy ~ Real compiled languages, taught with maximum cat energy">
    <section class="hero">
        <div class="container hero__inner">
            <div class="hero__text stack">
                <span class="chip">🐾 The school for cat-flavored programming</span>
                <h1 class="hero__title">
                    real compiled<br />
                    languages.<br />
                    <span class="hero__title--accent">maximum cat energy.</span>
                </h1>
                <p class="hero__lede">
                    Meowademy teaches you esoteric programming languages that
                    actually compile. Start with <strong>LolRust</strong> ~
                    real Rust under the hood, lolcat speak on top, the borrow
                    checker rebranded as the No Touchie Checker.
                </p>
                <div class="hero__cta">
                    <a href="/lolrust/lesson-1" class="btn">Start lesson 1</a>
                    <a href="#courses" class="btn btn-ghost">See all courses</a>
                </div>
            </div>

            <div class="hero__editor card">
                <MeowEditor initial={heroSnippet} compact={true} id="hero" />
                <p class="hero__editor-note dim">
                    This editor runs the actual lolrust → Rust transpiler in
                    your browser via WebAssembly. Hit Run, see the real Rust.
                </p>
            </div>
        </div>
    </section>

    <section id="courses" class="courses">
        <div class="container">
            <h2 class="section-title">Courses</h2>
            <p class="dim">One real course. Two pretend ones. We'll get there.</p>
            <div class="courses__grid">
                {courses.map(course => (
                    <a
                        href={course.status === 'available' ? course.href : '#'}
                        class={`course-card ${course.status === 'soon' ? 'course-card--soon' : ''}`}
                    >
                        <div class="course-card__head">
                            <h3>{course.name}</h3>
                            <span class={`chip ${course.status === 'soon' ? '' : 'chip--success'}`}>
                                {course.status === 'soon' ? 'soon™' : `${course.lessons} lessons`}
                            </span>
                        </div>
                        <p class="course-card__tag">{course.tagline}</p>
                        <p class="dim">{course.blurb}</p>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="why">
        <div class="container">
            <h2 class="section-title">Why Meowademy?</h2>
            <div class="why__grid">
                <div class="why__cell">
                    <h3>It's real</h3>
                    <p>LolRust transpiles to actual Rust and compiles with rustc. The languages here are jokes, but the binaries aren't.</p>
                </div>
                <div class="why__cell">
                    <h3>The checker is honest</h3>
                    <p>The No Touchie Checker isn't a fake "✅ great job!" overlay. It runs the real transpiler in your browser and verifies the output structurally. You can't cheat the cat.</p>
                </div>
                <div class="why__cell">
                    <h3>Built in browser</h3>
                    <p>The whole transpiler ships as a 38KB WebAssembly module. No server round-trips. No accounts. No spinner.</p>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .hero {
        padding: clamp(40px, 6vw, 80px) 0;
    }
    .hero__inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
    }
    @media (max-width: 1000px) {
        .hero__inner { grid-template-columns: 1fr; }
    }
    .hero__title {
        font-size: clamp(2rem, 5vw, 3.4rem);
        line-height: 1.3;
        margin: 16px 0;
    }
    .hero__title--accent { color: var(--yellow); text-shadow: 0 0 14px rgba(255, 204, 0, 0.4); }
    .hero__lede {
        font-size: 1.05rem;
        color: var(--text);
        max-width: 52ch;
    }
    .hero__cta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-top: 16px;
    }
    .hero__editor {
        background: var(--bg-card);
    }
    .hero__editor-note {
        font-size: 0.8rem;
        margin: 16px 0 0;
        text-align: center;
    }

    .section-title {
        margin-bottom: 8px;
    }
    .courses {
        padding: clamp(40px, 6vw, 80px) 0;
        border-top: 1px solid rgba(255, 0, 255, 0.2);
    }
    .courses__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-top: 32px;
    }
    .course-card {
        display: block;
        background: var(--bg-card);
        border: 2px solid var(--magenta);
        border-radius: 16px;
        padding: 24px;
        color: var(--text);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .course-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px var(--magenta-glow);
        color: var(--text);
    }
    .course-card--soon {
        opacity: 0.55;
        cursor: not-allowed;
    }
    .course-card--soon:hover {
        transform: none;
        box-shadow: none;
    }
    .course-card__head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .course-card__head h3 {
        margin: 0;
        font-family: var(--font-display);
        color: var(--magenta);
    }
    .course-card__tag {
        color: var(--yellow);
        font-size: 0.85rem;
        margin: 0 0 12px;
    }

    .why {
        padding: clamp(40px, 6vw, 80px) 0;
        border-top: 1px solid rgba(255, 0, 255, 0.2);
    }
    .why__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 32px;
        margin-top: 32px;
    }
    .why__cell h3 {
        margin: 0 0 8px;
    }
</style>
