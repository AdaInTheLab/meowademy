---
import { availableDocs, comingSoonDocs, docHref } from '../data/lolrust';

const available = availableDocs();
const coming = comingSoonDocs();
---
<section class="doc-index">
    {available.length > 0 && (
        <>
            <h2>Available Now</h2>
            <ul class="doc-list">
                {available.map((page) => (
                    <li>
                        <a href={docHref(page)}>{page.title}</a>
                        <span class="dim"> ~ {page.summary}</span>
                    </li>
                ))}
            </ul>
        </>
    )}

    {coming.length > 0 && (
        <>
            <h2>Coming Soon</h2>
            <ul class="doc-list doc-list--coming">
                {coming.map((page) => (
                    <li>
                        <strong>{page.title}</strong>
                        <span class="dim"> ~ {page.summary}</span>
                    </li>
                ))}
            </ul>
        </>
    )}
</section>

<style>
    .doc-index {
        margin: 24px 0;
    }
    .doc-list {
        list-style: none;
        padding: 0;
        margin: 0 0 32px;
    }
    .doc-list li {
        padding: 8px 0;
        border-bottom: 1px solid var(--bg-card-2);
    }
    .doc-list li:last-child {
        border-bottom: none;
    }
    .doc-list--coming li {
        opacity: 0.7;
    }
    .doc-list a {
        color: var(--magenta);
        font-weight: 600;
        text-decoration: none;
    }
    .doc-list a:hover {
        color: var(--yellow);
        text-decoration: underline;
        text-decoration-color: var(--yellow);
    }
    .doc-list strong {
        color: var(--text-muted);
    }
</style>
