---
import MainLayout from './MainLayout.astro';

interface Props {
    frontmatter: {
        title: string;
        description?: string;
    };
}

const { frontmatter } = Astro.props;
const pageTitle = `${frontmatter.title} ~ LolRust Docs`;
---
<MainLayout title={pageTitle} description={frontmatter.description}>
    <article class="docs container">
        <slot />
    </article>
</MainLayout>

<style>
    .docs {
        max-width: 72ch;
        padding-top: 32px;
        padding-bottom: 64px;
        line-height: 1.65;
    }
    .docs :global(h1) {
        font-family: var(--font-display);
        font-size: 1.4rem;
        color: var(--magenta);
        text-shadow: 0 0 14px var(--magenta-glow);
        letter-spacing: 0.04em;
        margin: 0 0 24px;
    }
    .docs :global(h2) {
        font-family: var(--font-display);
        font-size: 0.95rem;
        color: var(--yellow);
        margin: 40px 0 12px;
        letter-spacing: 0.03em;
    }
    .docs :global(h3) {
        font-size: 1.05rem;
        color: var(--magenta-soft);
        margin: 28px 0 8px;
    }
    .docs :global(p) {
        margin: 0 0 1em;
    }
    .docs :global(a) {
        color: var(--magenta);
        text-decoration: underline;
        text-decoration-color: var(--magenta-glow);
    }
    .docs :global(a:hover) {
        color: var(--yellow);
    }
    .docs :global(code) {
        font-family: var(--font-mono);
        background: var(--bg-card);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
        color: var(--magenta-soft);
    }
    .docs :global(pre) {
        background: var(--bg-card);
        border: 1px solid var(--bg-card-2);
        padding: 16px;
        border-radius: 6px;
        overflow-x: auto;
        margin: 0 0 1.2em;
    }
    .docs :global(pre code) {
        background: transparent;
        padding: 0;
        color: var(--text);
        font-size: 0.85rem;
    }
    .docs :global(ul) {
        margin: 0 0 1em;
        padding-left: 1.5em;
    }
    .docs :global(li) {
        margin-bottom: 0.4em;
    }
    .docs :global(blockquote) {
        border-left: 3px solid var(--magenta);
        margin: 1em 0;
        padding: 0.4em 1em;
        background: var(--bg-card);
        color: var(--text-muted);
    }
</style>
