---
import MainLayout from './MainLayout.astro';
import MeowEditor from '../components/MeowEditor.astro';
import ProgressSidebar from '../components/ProgressSidebar.astro';

interface Keyword { code: string; note: string; }
interface Check { label: string; pattern: string; flags?: string; negate?: boolean; }
interface Nav { href: string; label: string; }

interface Props {
    course: string;
    number: number;
    name: string;
    objective: string;
    keywords: Keyword[];
    initial: string;
    checks: Check[];
    prev?: Nav;
    next?: Nav;
    award?: string | null;
    hints?: string[];
    solution?: string | null;
}

const {
    course, number, name, objective, keywords, initial, checks, prev, next,
    award = null, hints = [], solution = null,
} = Astro.props;
const editorId = `lesson-${number}`;
---
<MainLayout title={`Lesson ${number}: ${name} ~ Meowademy`}>
    <ProgressSidebar />
    <div
        class="lesson container"
        data-lesson-page
        data-lesson-number={number}
        data-prev-number={prev ? Number(prev.href.match(/lesson-(\d+)/)?.[1] || 0) : 0}
    >
        <div class="lesson__head">
            <div>
                <span class="chip">Course: {course}</span>
                <h1>Lesson {number}<span class="lesson__divider"> ~ </span><span class="lesson__sub">{name}</span></h1>
            </div>
            <nav class="lesson__nav">
                {prev && <a href={prev.href} class="dim">← {prev.label}</a>}
                {!prev && <a href="/" class="dim">← home</a>}
                {next && (
                    <a
                        href={next.href}
                        class="lesson__next"
                        data-next-link
                        data-next-href={next.href}
                        aria-disabled="true"
                    >
                        🔒 {next.label} →
                    </a>
                )}
            </nav>
        </div>

        <div class="lesson__body" data-lesson-body>
            <aside class="lesson__brief stack">
                <div class="card">
                    <h3>Objective</h3>
                    <p>{objective}</p>
                </div>

                <div>
                    <h3>New keywords</h3>
                    <ul class="kw">
                        {keywords.map(k => (
                            <li><code>{k.code}</code> <span class="dim">~ {k.note}</span></li>
                        ))}
                    </ul>
                </div>

                <slot name="extras" />

                <pre class="cat-art mono">/\_/\
( o.o )
 > ^ <</pre>
            </aside>

            <section class="lesson__editor">
                <MeowEditor
                    initial={initial}
                    checks={checks}
                    id={editorId}
                    award={award}
                    lessonNumber={number}
                    hints={hints}
                    solution={solution}
                />
            </section>
        </div>

        <div class="lesson__locked" data-lesson-locked hidden>
            <div class="card lesson__locked-card">
                <div class="lesson__locked-icon">🔒</div>
                <h2>Lesson <span data-locked-num>{number}</span> is locked</h2>
                <p>You need to complete the previous lesson before this one unlocks.</p>
                <p>
                    <a href="" class="btn" data-back-to-prev>← Back to previous lesson</a>
                </p>
                <p class="dim" style="margin-top: 24px;">
                    Or use the <strong>Progress</strong> tab on the right to jump to where you left off.
                </p>
            </div>
        </div>
    </div>

    <script>
        import { isUnlocked, isCompleted, getHighestUnlocked, subscribe } from '../scripts/progress.js';

        const page = document.querySelector('[data-lesson-page]');
        if (page) {
            const n = Number(page.getAttribute('data-lesson-number'));
            const prevN = Number(page.getAttribute('data-prev-number'));
            const body = page.querySelector('[data-lesson-body]');
            const lockedView = page.querySelector('[data-lesson-locked]');
            const lockedNumEl = page.querySelector('[data-locked-num]');
            const backLink = page.querySelector('[data-back-to-prev]');
            const nextLink = page.querySelector('[data-next-link]');
            const nextHref = nextLink?.getAttribute('data-next-href') || '';

            function applyLock() {
                const unlocked = isUnlocked(n);
                if (unlocked) {
                    body?.removeAttribute('hidden');
                    lockedView?.setAttribute('hidden', '');
                } else {
                    body?.setAttribute('hidden', '');
                    lockedView?.removeAttribute('hidden');
                    if (lockedNumEl) lockedNumEl.textContent = String(n);
                    if (backLink && prevN) backLink.setAttribute('href', `/lolrust/lesson-${prevN}`);
                }
            }

            function applyNextLock() {
                if (!nextLink) return;
                const done = isCompleted(n);
                if (done) {
                    nextLink.removeAttribute('aria-disabled');
                    nextLink.classList.remove('lesson__next--disabled');
                    nextLink.textContent = nextLink.textContent.replace(/^🔒\s*/, '');
                    nextLink.setAttribute('href', nextHref);
                } else {
                    nextLink.setAttribute('aria-disabled', 'true');
                    nextLink.classList.add('lesson__next--disabled');
                    if (!nextLink.textContent.startsWith('🔒')) {
                        nextLink.textContent = '🔒 ' + nextLink.textContent;
                    }
                    nextLink.setAttribute('href', '#');
                }
            }

            applyLock();
            applyNextLock();
            subscribe(applyLock);
            subscribe(applyNextLock);

            // Block click on disabled next link
            nextLink?.addEventListener('click', (e) => {
                if (nextLink.getAttribute('aria-disabled') === 'true') {
                    e.preventDefault();
                }
            });
        }
    </script>
</MainLayout>

<style>
    .lesson {
        padding: clamp(28px, 4vw, 48px) var(--pad-page);
    }
    .lesson__head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255, 0, 255, 0.2);
    }
    .lesson__head h1 { margin: 12px 0 0; }
    .lesson__divider { color: var(--text-dim); }
    .lesson__sub { color: var(--yellow); text-shadow: 0 0 12px rgba(255, 204, 0, 0.3); }
    .lesson__nav {
        display: flex;
        gap: 24px;
        font-family: var(--font-display);
        font-size: 0.7rem;
        letter-spacing: 0.05em;
    }
    .lesson__body {
        display: grid;
        grid-template-columns: minmax(260px, 360px) 1fr;
        gap: 36px;
    }
    @media (max-width: 900px) {
        .lesson__body { grid-template-columns: 1fr; }
    }
    .kw { list-style: none; padding: 0; margin: 0; }
    .kw li { padding: 6px 0; font-size: 0.92rem; }
    .cat-art {
        background: transparent;
        border: none;
        color: var(--yellow);
        font-size: 1.3rem;
        line-height: 1.3;
        text-align: center;
        padding: 16px 0;
        text-shadow: 0 0 12px rgba(255, 204, 0, 0.4);
    }

    .lesson__next {
        color: var(--yellow);
    }
    .lesson__next--disabled,
    .lesson__next[aria-disabled="true"] {
        color: var(--text-dim);
        cursor: not-allowed;
        pointer-events: none;
        text-decoration: line-through;
        opacity: 0.5;
    }

    .lesson__locked {
        max-width: 640px;
        margin: 60px auto;
        text-align: center;
    }
    .lesson__locked-card { padding: 48px 32px; }
    .lesson__locked-icon {
        font-size: 4rem;
        margin-bottom: 12px;
        filter: drop-shadow(0 0 16px var(--magenta-glow));
    }
    .lesson__locked .btn {
        margin-top: 16px;
        display: inline-block;
    }
</style>
