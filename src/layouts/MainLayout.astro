---
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
}
const { title, description = 'Real compiled languages, taught with maximum cat energy.' } = Astro.props;

const SITE_URL = 'https://meowademy.com';
const SOCIAL_IMAGE = `${SITE_URL}/social.jpg`;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐱</text></svg>" />
    <title>{title}</title>

    <!-- Open Graph (Facebook, LinkedIn, Discord, Slack, iMessage previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meowademy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={SOCIAL_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Meowademy ~ Real compiled languages, taught with maximum cat energy." />

    <!-- Twitter / X (large image card) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SOCIAL_IMAGE} />
    <meta name="twitter:image:alt" content="Meowademy ~ Real compiled languages, taught with maximum cat energy." />

    <!-- Theme color (mobile address bar) -->
    <meta name="theme-color" content="#0a0014" />

    <!-- Matomo (self-hosted at analytics.kitsuneden.net) -->
    <script is:inline>
      var _paq = window._paq = window._paq || [];
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u = "//analytics.kitsuneden.net/";
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '11']);
        var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
        g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
      })();
    </script>
</head>
<body>
    <header class="site-header">
        <div class="container site-header__inner">
            <a href="/" class="brand">
                <span class="brand__cat">🐱</span>
                <span class="brand__name">MEOWADEMY</span>
            </a>
            <nav class="site-nav">
                <a href="/lolrust/lesson-1">Lessons</a>
                <a href="/lolrust/docs">Docs</a>
                <a href="https://github.com/AdaInTheLab/lolrust" target="_blank" rel="noopener">GitHub</a>
            </nav>
        </div>
    </header>

    <main>
        <slot />
    </main>

    <footer class="site-footer">
        <div class="container">
            <p class="dim">
                Made with <code>yolo</code> energy and zero regrets ~
                <a href="https://github.com/AdaInTheLab/lolrust">lolrust</a> on GitHub
            </p>
            <nav class="site-footer__nav">
                <a href="/privacy">Privacy</a>
                <span class="dim">·</span>
                <a href="/terms">Terms</a>
                <span class="dim">·</span>
                <a href="https://github.com/AdaInTheLab/meowademy" target="_blank" rel="noopener">Source</a>
            </nav>
        </div>
    </footer>
</body>
</html>

<style>
    .site-header {
        border-bottom: 2px solid var(--magenta);
        background: linear-gradient(180deg, var(--bg-base) 0%, var(--bg-deep) 100%);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(8px);
    }
    .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 18px;
        padding-bottom: 18px;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }
    .brand__cat { font-size: 1.6rem; filter: drop-shadow(0 0 8px var(--magenta-glow)); }
    .brand__name {
        font-family: var(--font-display);
        font-size: 1.15rem;
        color: var(--magenta);
        text-shadow: 0 0 14px var(--magenta-glow);
        letter-spacing: 0.08em;
    }
    .site-nav {
        display: flex;
        gap: 24px;
        font-family: var(--font-display);
        font-size: 0.7rem;
        letter-spacing: 0.05em;
    }
    .site-nav a {
        color: var(--text-muted);
        text-transform: uppercase;
    }
    .site-nav a:hover {
        color: var(--yellow);
    }
    main {
        min-height: calc(100vh - 180px);
    }
    .site-footer {
        border-top: 2px solid var(--magenta);
        padding: 32px 0;
        margin-top: 64px;
        text-align: center;
        font-size: 0.85rem;
    }
    .site-footer__nav {
        margin-top: 12px;
        display: flex;
        gap: 12px;
        justify-content: center;
        align-items: center;
        font-family: var(--font-display);
        font-size: 0.65rem;
        letter-spacing: 0.05em;
    }
    .site-footer__nav a {
        color: var(--text-muted);
        text-transform: uppercase;
    }
    .site-footer__nav a:hover { color: var(--yellow); }
</style>
